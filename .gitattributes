# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files with LF endings
*.php text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf

# ICS calendar files should use CRLF (RFC 5545 standard)
*.ics text eol=crlf

# Shell scripts
*.sh text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
